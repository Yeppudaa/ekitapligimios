// Development-signed builds use the production app record so Apple Sandbox
// can resolve the same subscription products when local StoreKit mode is off.
PRODUCT_BUNDLE_IDENTIFIER = com.ekitapligim.app
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
EKITAPLIGIM_ENVIRONMENT = development
EKITAPLIGIM_API_BASE_URL = https://ekitapligim.local.invalid/ios-api/v1/
